# ── Backend ────────────────────────────────────────────────────────────────────
# Get your GROQ API key from: https://console.groq.com/
GROQ_API_KEY=

# Secret key for JWT token signing (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=change-me-to-a-random-secret-string

# Get your Sarvam AI API key from: https://sarvam.ai
SARVAM_API_KEY=

# Get your Deepgram API key from: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=

# Get your Supadata API key from: https://supadata.ai/
SUPADATA_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Backend API URL (update if deploying to a different server)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
